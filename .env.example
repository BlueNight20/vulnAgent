# ============================================================
# VulnAgent 环境变量样例
# 复制为 .env 后按需修改；不要提交真实密钥。
# ============================================================

# ---------- 服务端口 ----------
# 后端 API 端口（前端 Vite 代理会转发到这里）
PORT=3001
# 默认仅监听本机；确需远端部署时显式配置，并部署鉴权与访问控制。
VA_API_HOST=127.0.0.1
# 允许跨域的前端地址
WEB_ORIGIN=http://localhost:5173
# 后端调用前置地址（仅用于文档展示）
API_BASE_URL=http://localhost:3001

# ---------- 数据库 ----------
DB_TYPE=sqlite
# SQLite 文件路径（相对 apps/api 运行时工作目录）
DB_PATH=./storage/vulnagent.sqlite
# 使用显式迁移，保持关闭自动同步
DB_SYNCHRONIZE=false
DB_LOGGING=false
# PostgreSQL 参数仅为历史预留，当前未完成适配；请保持 DB_TYPE=sqlite
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=vulnagent
# DB_PASSWORD=change_me
# DB_DATABASE=vulnagent

# ---------- 安全 ----------
# AES-256-GCM 主密钥：32 字节随机值的 base64，例如
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 留空时 SQLite 首次保存密钥会创建 DB_PATH.key；重启复用，丢失时不能解密旧数据。
VA_ENCRYPTION_KEY=
# 可选：指定持久化主密钥文件；相对 API 运行目录。环境主密钥优先。
# PostgreSQL / 内存库须显式配置环境主密钥或此路径。
VA_ENCRYPTION_KEY_FILE=

# ---------- MCP（blhackbox） ----------
# 默认只连接 blhackbox 的 MCP Gateway 统一入口，其余服务由网关发现。
# 不要假定 Gateway 已启动：未启动时 MCP 管理页会显示真实的「未连接」状态。
MCP_GATEWAY_NAME=blhackbox-gateway
MCP_GATEWAY_URL=http://localhost:8080/mcp
MCP_GATEWAY_ENABLED=true
MCP_TRANSPORT=streamable-http
# 健康检查超时（毫秒）
MCP_HEALTH_TIMEOUT_MS=5000
# 健康检查超时上限：工具数多的服务（如 HexStrike 150 个工具）会自动放宽到该值
MCP_HEALTH_TIMEOUT_MAX_MS=60000
# 单次工具执行超时（毫秒）。注意 HexStrike 服务端自身有约 60s 的硬限制，# 超过该值仍会被服务端中断，因此关键是让 Agent 用更小的扫描范围，而不是一味调大此值
MCP_TOOL_TIMEOUT_MS=300000
# MCP 握手超时（毫秒），并发调用时可调大
MCP_CONNECT_TIMEOUT_MS=60000
MCP_MAX_SCAN_HOSTS=256
MCP_MAX_SCAN_PORTS=1024
MCP_MAX_SCAN_PROBES=4096
# 同一服务重复检测的缓存时间（毫秒）
MCP_HEALTH_CACHE_TTL_MS=30000
# 预留：认证头，格式为 JSON，例如 {"Authorization":"Bearer xxx"}
MCP_GATEWAY_HEADERS=

# ---------- 云端模型（OpenAI 兼容端点） ----------
# 设置页保存后用于 Planner / Worker；连接测试会显式请求模型端点。
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
# 也可以在此配置 API Key（也可后续在系统设置页写入，入库时 AES-256-GCM 加密）
MODEL_API_KEY=
MODEL_TEMPERATURE=0.2
MODEL_MAX_TOKENS=4096

# ---------- 执行引擎 ----------
# 默认关闭。设置页保存的开关优先于此值；关闭暂停任务，重新开启须手动恢复。
PI_RUNTIME_ENABLED=false
# 所有任务合计的 Worker 分配上限，含派发排队；数据库设置优先
WORKER_MAX_CONCURRENCY=2
# 模型请求并发上限
MODEL_MAX_CONCURRENCY=2
# 新任务表单默认 Token / 时间预算 / 数量；每次打开读取保存的设置
DEFAULT_TOKEN_BUDGET=200000
DEFAULT_TIME_BUDGET_MINUTES=60
DEFAULT_WORKER_COUNT=2

# ---------- 日志 ----------
# 未保存设置时的默认值；设置页保存的级别/文件开关优先并即时生效
LOG_LEVEL=info
LOG_TO_FILE=false
# 相对 API 运行目录；启用后追加 vulnagent.jsonl，不自动删除或轮换历史日志
LOG_DIR=./storage/logs

# 手工数据清理前的完整备份目录；留空时使用数据库同目录 maintenance-backups
VA_MAINTENANCE_BACKUP_DIRECTORY=
