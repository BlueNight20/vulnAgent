{
  "name": "@vulnagent/api",
  "version": "0.1.0",
  "private": true,
  "description": "VulnAgent 后端（NestJS + TypeORM + SQLite + MCP 客户端）",
  "scripts": {
    "predev": "node ../../scripts/patch-nest-assets.cjs",
    "dev": "npm run build:shared && nest start --watch",
    "start": "node dist/main.js",
    "prebuild": "node ../../scripts/patch-nest-assets.cjs",
    "build": "npm run build:shared && nest build",
    "build:shared": "tsc -p ../../packages/shared/tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "typeorm migration:run -d dist/database/data-source.js",
    "db:show": "typeorm migration:show -d dist/database/data-source.js",
    "db:revert": "typeorm migration:revert -d dist/database/data-source.js",
    "db:maintenance": "node dist/database/maintenance-cli.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-ws": "11.2.8",
    "@nestjs/typeorm": "11.0.3",
    "@nestjs/websockets": "11.2.8",
    "@vulnagent/shared": "file:../../packages/shared",
    "ajv": "^8.20.0",
    "better-sqlite3": "12.4.1",
    "bindings": "1.5.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "fflate": "^0.8.3",
    "fontkit": "^2.0.4",
    "image-size": "^2.0.4",
    "joi": "17.13.9",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.31",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "11.2.8",
    "@types/better-sqlite3": "7.6.12",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pdfkit": "^0.17.3",
    "@types/ws": "8.5.13",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
